//--------    FILE: bravo_uuv_surface.bhv   -------------

initialize   DEPLOY = false
initialize   RETURN = false
initialize   LOITER_REGION=west
initialize   SURFACE = false
	
Behavior = BHV_Loiter
 {
   // General Behavior Parameters
   // ---------------------------
   name         = BHV_Loiter_A              // example
   pwt          = 100                   // default
   condition = RETURN = false
   condition = DEPLOY = true
   condition = SURFACE = false
   condition=LOITER_REGION=east
   endflag=LOITER_REGION=west
   duration_reset = timer_east = TRUE
   endflag = timer_east = TRUE

	 endflag   = SUMMARY=speed=$[SPEED],time=$[DUR_RUN_TIME]
   updates      = LOITER_UPDATES        // example

   // Parameters specific to this behavior 
   // ------------------------------------
        acquire_dist = 10               // default
      capture_radius = 3               // default  
     center_activate = false            // default
           clockwise = false             // default
         slip_radius = 15               // default
               speed = 2.5                // updated m/s
       spiral_factor = -2               // default

             polygon = radial:: x=100,y=-75,radius=30,pts=8  // bravo loiter
         post_suffix = HENRY                             // example

       center_assign = 200,-60           // example
      xcenter_assign = 200              // example
      ycenter_assign = -60               // example

      duration = 150 
      duration_idle_decay = false
      perpetual=true


        visual_hints = vertex_size  = 1             // default
        visual_hints = edge_size    = 1             // default
        visual_hints = vertex_color = dodger_blue   // default
        visual_hints = edge_color   = white         // default
        visual_hints = nextpt_color = yellow        // default
        visual_hints = nextpt_lcolor = aqua         // default
        visual_hints = nextpt_vertex_size = 5       // default
        visual_hints = label        = east         // example
 }

Behavior = BHV_Loiter
 {
   // General Behavior Parameters
   // ---------------------------
   name         = BHV_Loiter_B              // example
   pwt          = 100                   // default
   condition = RETURN = false
   condition = DEPLOY = true
   condition=LOITER_REGION=west
   condition = SURFACE = false
   //endflag   = RETURN = true
   endflag=LOITER_REGION=east
   duration_reset = timer_west = TRUE
   endflag = timer_west = TRUE

	 endflag   = SUMMARY=speed=$[SPEED],time=$[DUR_RUN_TIME]
   updates      = LOITER_UPDATES        // example

   // Parameters specific to this behavior 
   // ------------------------------------
        acquire_dist = 10               // default
      capture_radius = 3               // default  
     center_activate = false            // default
           clockwise = false             // default
         slip_radius = 15               // default
               speed = 2.5                // updated m/s
       spiral_factor = -2               // default

             polygon = radial:: x=160,y=-50,radius=20,pts=8  // bravo loiter
         post_suffix = HENRY                             // example

       center_assign = 50,-60           // example
      xcenter_assign = 50              // example
      ycenter_assign = -60               // example

      duration = 150 
      duration_idle_decay = false
      perpetual=true


        visual_hints = vertex_size  = 1             // default
        visual_hints = edge_size    = 1             // default
        visual_hints = vertex_color = dodger_blue   // default
        visual_hints = edge_color   = white         // default
        visual_hints = nextpt_color = yellow        // default
        visual_hints = nextpt_lcolor = aqua         // default
        visual_hints = nextpt_vertex_size = 5       // default
        visual_hints = label        = west         // example
 }

//----------------------------------------------

Behavior=BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  // condition = RETURN = true
  condition = DEPLOY = true
  condition = (RETURN=true) or (ODOMETRY_DIST_AT_DEPTH>=200) 
  perpetual = true
  updates   = RETURN_UPDATE
  endflag   = RETURN=false
  endflag   = DEPLOY=false
  endflag   = MISSION=complete
  speed = 2.0
  capture_radius = 2.0
  slip_radius = 8.0
  points = 0,-20
}

//----------------------------------------------

 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = DEPTH_LOITER_EAST   // example
   pwt          = 100                // default
   condition    = DEPLOY=true
   condition    = LOITER_REGION=east
   updates      = CONST_DEP_UPDATES  // example
   endflag      = LOITER_REGION=west
   perpetual    = true

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 10          // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = no-time-limit          // default (Choose something higher!)
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

  Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = DEPTH_LOITER_WEST   // example
   pwt          = 100                // default
   condition    = DEPLOY=true
   condition    = LOITER_REGION=west
   updates      = CONST_DEP_UPDATES  // example
   endflag      = LOITER_REGION=east
   perpetual    = true

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 30           // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = no-time-limit            // default (Choose something higher!)
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

Behavior = BHV_Timer
 {
   // General Behavior Parameters
   // ---------------------------
   name         = bhv_timer_surface           // default
   // condition    = WAIT_REQUEST=true    // example
   duration     = 200                  // example
   condition = SURFACE = false
   perpetual = true
   endflag = SURFACE = true
  //  endflag = SURF_RESET = true
   duration_idle_decay   = false
 }

Behavior = BHV_Timer
 {
   // General Behavior Parameters
   // ---------------------------
   name         = bhv_timer_at_surface           // default
   // condition    = WAIT_REQUEST=true    // example
   duration     = 60                  // exampl
  //  condition = NAV_DEPTH > 0
   condition = SURFACED = true
   perpetual = true
   endflag = SURFACE = false
   endflag = SURFACED = false
   duration_idle_decay   = false
   //endflag = SURF_RESET = true
 }
 
 
 Behavior = BHV_ConstantDepth
 {
   // General Behavior Parameters
   // ---------------------------
   name         = DEPTH_LOITER_SURFACE   // example
   pwt          = 100                // default
   condition    = DEPLOY=true
   condition    = SURFACE=true
   // condition    = LOITER_REGION=west
   duration_reset = SURF_RESET=true
   updates      = CONST_DEP_UPDATES  // example
   endflag      = SURFACED=true
   perpetual    = true

   // Parameters specific to this behavior
   // ------------------------------------
            basewidth = 100          // default
                depth = 0           // default
   depth_mismatch_var = DEPTH_DIFF   // example
             duration = no-time-limit          
             duration_idle_decay = false
            peakwidth = 3            // default
          summitdelta = 50           // default
 }

 Behavior=BHV_ConstantSpeed
{
  name      = surface_speed
  pwt       = 200
  condition = DEPLOY = true
  condition = SURFACE = true
  updates   = SPEED_UPDATE
  endflag   = SURFACE=false
  perpetual = true

           speed = 0
		    duration = no-time-limit
	duration_reset = CONST_SPD_RESET=true
	
}
